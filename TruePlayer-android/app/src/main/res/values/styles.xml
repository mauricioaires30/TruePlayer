<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A janela já começa na cor de fundo real do app, para não piscar antes do Compose desenhar:
        claro aqui (#FBF8FF) e escuro em values-night (#050307). Se o usuário escolher um tema diferente
        do Android, a MainActivity troca o fundo da janela ao abrir.
    -->
    <style name="Theme.TrueTagger" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#FBF8FF</item>
        <item name="android:colorBackground">#FBF8FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#FBF8FF</item>
        <item name="android:navigationBarColor">#FBF8FF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.TrueTagger.Share" parent="@style/Theme.TrueTagger">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
